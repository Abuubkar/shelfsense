# Every key the code reads today. Defaults live in apps/api/src/shelfsense_api/settings.py.
DATABASE_URL=postgresql+asyncpg://shelfsense:shelfsense@localhost:5436/shelfsense
FEEDS_DIR=data/feeds
TAXONOMY_VERSION=2021-09-21
CANDIDATE_COUNT=15
OPENSEARCH_URL=http://localhost:9201
SEARCH_CURSOR_TTL=5m
KNN_MIN_SCORE=0.80
HYBRID_WEIGHTS=[0.5,0.5]
CURSOR_SECRET=change-me
