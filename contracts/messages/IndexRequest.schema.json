{
  "description": "Index these products from Postgres into OpenSearch. Sent by the enrich worker for products it enriched.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "product_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Product Ids",
      "type": "array"
    },
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    }
  },
  "required": [
    "product_ids"
  ],
  "title": "IndexRequest",
  "type": "object"
}
